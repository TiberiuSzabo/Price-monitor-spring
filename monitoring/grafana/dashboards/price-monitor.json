      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pricemonitor_products_tracked{job=\"price-monitor\"})",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true
