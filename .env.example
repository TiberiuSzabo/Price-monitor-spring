# Copy to .env and adjust. Never commit .env.
# Everything here is optional for local use: docker-compose.yml has a working
# development default for each variable.

# ---- Application ----
# dev  = human-readable logs, defaults for every setting
# prod = JSON logs, database settings must be provided
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8081

# Scraper tuning (milliseconds)
PRICEMONITOR_CHECK_INTERVAL_MS=3600000
PRICEMONITOR_DELAY_BETWEEN_REQUESTS_MS=5000
PRICEMONITOR_HTTP_TIMEOUT_MS=10000

# ---- Database ----
POSTGRES_DB=pricemonitor
POSTGRES_USER=pricemonitor
POSTGRES_PASSWORD=change-me

# ---- Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Host ports (change only if something else already uses them) ----
# All of these except APP_PORT are bound to 127.0.0.1.
MANAGEMENT_PORT=9001
POSTGRES_HOST_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
